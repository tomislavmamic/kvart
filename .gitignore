# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# isolated feature worktrees created by agent workflows
/.worktrees/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …osim predloška: on nosi samo imena varijabli i objašnjenja, nijednu
# pravu vrijednost, a bez njega se ne vidi što treba postaviti.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# preuzeti izvorni planovi sa split.hr (~265 MB PDF-ova) — prevelik za git
/data/sources/planovi/

# python bytecode iz scripts/vectorize-plans.py
__pycache__/

# Dnevnik sesija alata za dizajn: lokalno stanje za nastavak nakon prekida,
# ne izvorni kod. Postavke (config.json) ostaju u gitu jer vrijede za projekt.
/.impeccable/live/sessions/

# PNG predlošci za /admin/georef (18 MB) — izrađuje ih
# scripts/render-plan-previews.py, alat postoji samo u razvoju
/public/geo/planovi/preview/

# preuzeti prostorni arhivi u korijenu (SHP.zip i sl.) — prevelik za git,
# a `git add -A` ih inače pokupi
/*.zip

# Katastarske čestice s vlasništvom: stupci iz zemljišne knjige imenuju
# fizičke osobe, uz OIB, i bilježe hipoteke i služnosti. Repozitorij je
# javan, pa bi commit bio objava osobnih podataka — i trajna, jer datoteka
# ostaje u povijesti i nakon što je se obriše.
#
# Sloj zato postoji samo lokalno: izrađuje ga `npm run import-grad-geo`, a
# karta ga prikazuje samo pod `next dev` (vidi SAMO_LOKALNO u map-views.ts).
/public/geo/grad/katastar-vlasnistvo.geojson

# Podloge za širi obuhvat (42 MB) — katastar, zgrade i ceste izrezani iz
# SHP.zip za prozor praćene namjene. Nisu u gitu jer ih `npm run
# izvadi-sire` u minuti izvadi iz arhive, a rezultat analize (mali
# GeoJSON u /public/geo/analiza/ i gotova stranica) jest.
/public/geo/sire/

# Privremeni OSS odgovori ciljane provjere vlasništva mogu sadržavati imena,
# adrese i OIB-e fizičkih osoba. Generator ih koristi samo lokalno za nastavak
# prekinutog rada; u Git i javni build ulazi isključivo sanitizirani GeoJSON.
/.cache/targeted-ownership/
