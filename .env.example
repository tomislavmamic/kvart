# Predložak okolišnih varijabli. Kopiraj u .env.local i popuni.
# .env.local je u .gitignore — prave vrijednosti nikad ne idu u repo.

# --- Obavezno ---

# PostgreSQL. src/lib/db/index.ts baca pri uvozu ako ovoga nema, pa bez
# njega ne prolazi ni gradnja. Lokalno je baza u kontejneru na 54329.
DATABASE_URL=postgres://korisnik:lozinka@localhost:54329/kvart

# Prijava moderatora na /admin.
MODERATOR_PASSWORD=
# Potpisivanje kolačića sesije. Dovoljno je `openssl rand -base64 32`.
SESSION_SECRET=

# --- Neobavezno: kanali zajednice ---
#
# Oboje se NAMJERNO ponaša tako da se bez vrijednosti ne prikaže ništa.
# Prije su imali zamjenske vrijednosti pa se dugme „Pridruži se WhatsApp
# grupi” crtalo i kad grupe nema, a poveznica na Reddit vodila na zajednicu
# koja ne postoji. Mrtav poziv na akciju gori je nego nijedan — ako je ovo
# prazno, na stranici jednostavno nema ni dugmeta ni spomena kanala.

# Pozivnica za WhatsApp grupu kvarta: https://chat.whatsapp.com/<kod>
# Dobiva se u grupi → Podaci o grupi → Pozovi putem poveznice.
NEXT_PUBLIC_WHATSAPP_URL=

# Ime subreddita BEZ "r/". Odloženo — zajednica još nije otvorena.
# Ostavi prazno dok ne postoji; postavljanjem se prikaz vraća sam.
NEXT_PUBLIC_SUBREDDIT=
