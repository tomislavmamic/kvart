# Što se NE šalje Vercelu pri objavi iz radnog direktorija.
#
# Postoji zato što se ovaj projekt objavljuje i preko `vercel --prod`, a
# tada se šalje sadržaj mape, ne ono što je u gitu. Čim ova datoteka
# postoji, Vercel prestaje gledati .gitignore — pa sve što ne smije van
# mora pisati ovdje, uključujući stvari koje .gitignore već pokriva.

# Tajne. .env.local nosi lozinku moderatora, potpisni ključ sesije i
# pristupne podatke baze; predložak (.env.example) smije van jer u njemu
# nema nijedne prave vrijednosti.
.env
.env.*
!.env.example

# Katastarske čestice s vlasništvom: imenuju fizičke osobe uz OIB i
# bilježe hipoteke. Datoteka postoji samo na razvojnom stroju (vidi
# .gitignore i SAMO_LOKALNO u src/lib/map-views.ts). Bez ovog retka
# objava iz radnog direktorija poslala bi je na javnu stranicu — što
# .gitignore ne može spriječiti jer ovdje git nije u igri.
/public/geo/grad/katastar-vlasnistvo.geojson

# Izvoz dojava iz produkcije (npm run izvezi-dojave): oznake preglednika
# i adrese dojavitelja. Analiza na razvojnom stroju, nikad na stranici.
/data/dojave.json

# Izvorna građa: prevelika, a za rad stranice nepotrebna.
/*.zip
/data/sources/
/public/geo/planovi/preview/

# Podloge za širi obuhvat: 42 MB ulaza iz kojih je izračunata analiza.
# Objavljuje se rezultat (/public/geo/analiza/ i slobodne-cestice.html),
# ne građa — stranica nosi geometriju u sebi i ove datoteke ne dohvaća.
/public/geo/sire/

# Metapodaci macOS-a. Nisu tajna, ali .DS_Store nosi popis imena datoteka iz
# mape u kojoj je nastao, a objava iz radnog direktorija ih inače pošalje sve.
.DS_Store

# Radna stabla za paralelne grane (`git worktree`). Svako je puna kopija
# projekta, a u njima znaju stajati i simbolične veze na `node_modules` i na
# predmemoriju — mjereno 2,8 GB. Objava iz radnog direktorija bi ih poslala
# sve, jer git ovdje nije u igri.
/.worktrees/

# Predmemorija ulaznih rastera: DMR s DGU WCS-a i HOK s WMS-a, 169 MB. To je
# GRAĐA iz koje skripte računaju, a ne ono što stranica poslužuje — rezultati
# su u /public/geo/ (pločice reljefa, izohipse, mreža visina, tokovi).
/.cache/

# Rezultati gradnje i alati — Vercel gradi iznova.
/.next/
/node_modules/
/.git/
/.impeccable/
__pycache__/
*.tsbuildinfo
